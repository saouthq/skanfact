{
  "name": "skanfact",
  "productName": "SkanFact",
  "version": "9.2.0",
  "description": "Devis et factures pour les petites entreprises",
  "main": "src/main.js",
  "author": "Skander Ben Amor",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "lint": "eslint .",
    "charge": "node test/charge-livre.js",
    "start:cabinet": "electron src/cabinet/main.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:cabinet:mac": "electron-builder --mac -c build/cabinet.config.js",
    "build:cabinet:win": "electron-builder --win -c build/cabinet.config.js",
    "release": "node scripts/release.js",
    "e2e:cabinet": "node test/e2e/cabinet.js",
    "e2e:boucle": "node test/e2e/boucle-complete.js",
    "e2e:entreprise": "node test/e2e/entreprise.js",
    "e2e:refus": "node test/e2e/cabinet-refus.js",
    "e2e:gel": "node test/e2e/chien-de-garde.js",
    "e2e:perte": "node test/e2e/cabinet-perte.js",
    "e2e:couches": "node test/e2e/cabinet-couches.js",
    "e2e:demenagement": "node test/e2e/cabinet-demenagement.js",
    "e2e:barre": "node test/e2e/barre-laterale.js",
    "e2e:captures": "node test/e2e/captures.js",
    "e2e:exemple": "node test/e2e/exemple.js",
    "e2e:reglages": "node test/e2e/reglages.js",
    "e2e:argent": "node test/e2e/argent.js",
    "e2e:contraste": "node test/e2e/contraste.js",
    "e2e:erreur": "node test/e2e/erreur.js",
    "e2e:apercu": "node test/e2e/apercu.js",
    "e2e:entreprises": "node test/e2e/entreprises.js",
    "e2e:cliquable": "node test/e2e/cliquable.js",
    "e2e:chiffres": "node test/e2e/chiffres.js",
    "e2e:repondre": "node test/e2e/repondre.js",
    "e2e:accueil": "node test/e2e/accueil.js",
    "e2e:editeur": "node test/e2e/editeur.js",
    "e2e:fiches": "node test/e2e/fiches.js",
    "e2e:compta": "node test/e2e/compta.js",
    "e2e:metier": "node test/e2e/metier.js",
    "e2e:retenue": "node test/e2e/retenue.js",
    "e2e:colonnes": "node test/e2e/colonnes.js",
    "e2e:aide": "node test/e2e/aide.js",
    "e2e:entetes": "node test/e2e/entetes.js",
    "e2e:beta": "node test/e2e/beta.js",
    "e2e:depot": "node test/e2e/depot.js",
    "e2e:partage": "node test/e2e/partage.js",
    "e2e:actions": "node test/e2e/actions.js",
    "e2e:parametres": "node test/e2e/parametres.js",
    "e2e:pages": "node test/e2e/pages.js",
    "e2e:console": "node test/e2e/console.js",
    "e2e:licence": "node test/e2e/licence.js",
    "e2e:plateforme": "node test/e2e/plateforme.js",
    "e2e:justificatif": "node test/e2e/justificatif.js",
    "e2e:pont": "node test/e2e/pont.js",
    "e2e:livres": "node test/e2e/livres.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^10.10.0",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "tn.skancyber.skanfact",
    "productName": "SkanFact",
    "files": [
      "src/**/*",
      "package.json",
      "CHANGELOG.md",
      "build/licence*.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "identity": null
    },
    "dmg": {
      "title": "SkanFact ${version}",
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SkanFact",
      "uninstallDisplayName": "SkanFact",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "saouthq",
      "repo": "skanfact",
      "releaseType": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saouthq/skanfact.git"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
