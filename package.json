{
  "name": "skanfact",
  "productName": "SkanFact",
  "version": "7.9.0",
  "description": "Devis et factures pour les petites entreprises",
  "main": "src/main.js",
  "author": "Skander Ben Amor",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "start:cabinet": "electron src/cabinet/main.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:cabinet:mac": "electron-builder --mac -c build/cabinet.config.js",
    "build:cabinet:win": "electron-builder --win -c build/cabinet.config.js",
    "release": "node scripts/release.js",
    "e2e:cabinet": "node test/e2e/cabinet.js",
    "e2e:boucle": "node test/e2e/boucle-complete.js",
    "e2e:entreprise": "node test/e2e/entreprise.js",
    "e2e:refus": "node test/e2e/cabinet-refus.js",
    "e2e:gel": "node test/e2e/chien-de-garde.js",
    "e2e:perte": "node test/e2e/cabinet-perte.js",
    "e2e:couches": "node test/e2e/cabinet-couches.js",
    "e2e:demenagement": "node test/e2e/cabinet-demenagement.js",
    "e2e:barre": "node test/e2e/barre-laterale.js",
    "e2e:captures": "node test/e2e/captures.js",
    "e2e:exemple": "node test/e2e/exemple.js",
    "e2e:reglages": "node test/e2e/reglages.js",
    "e2e:argent": "node test/e2e/argent.js"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^25.0.0",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "tn.skancyber.skanfact",
    "productName": "SkanFact",
    "files": [
      "src/**/*",
      "package.json",
      "CHANGELOG.md"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "identity": null
    },
    "dmg": {
      "title": "SkanFact ${version}",
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SkanFact",
      "uninstallDisplayName": "SkanFact",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "saouthq",
      "repo": "skanfact",
      "releaseType": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saouthq/skanfact.git"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
